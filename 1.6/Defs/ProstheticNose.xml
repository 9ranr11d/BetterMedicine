<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 인공 코: 바닐라 의치(Denture)처럼 아이템 없이 재료를 바로 쓰는 이식 수술.
       잘린 코에 인공 부위가 달리면 RelationsUtility.IsDisfigured 가 그 부위를 건너뛰어 외모 손상(호감 -15)이 사라진다. -->
  <HediffDef ParentName="AddedBodyPartBase">
    <defName>BM_ProstheticNose</defName>
    <label>prosthetic nose</label>
    <labelNoun>a prosthetic nose</labelNoun>
    <description>An installed steel prosthetic nose. It does nothing, but it covers the hole where a nose used to be.</description>
    <priceImpact>false</priceImpact>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>1</partEfficiency>
    </addedPartProps>
    <spawnThingOnRemoved>Steel</spawnThingOnRemoved>
  </HediffDef>

  <RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
    <defName>BM_InstallProstheticNose</defName>
    <label>install prosthetic nose</label>
    <description>Install a steel prosthetic nose.</description>
    <descriptionHyperlinks><ThingDef>Steel</ThingDef></descriptionHyperlinks>
    <jobString>Installing prosthetic nose.</jobString>
    <workAmount>1500</workAmount>
    <skillRequirements Inherit="False">
      <Medicine>3</Medicine>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Nose</li>
    </appliedOnFixedBodyParts>
    <addsHediff>BM_ProstheticNose</addsHediff>
    <uiIconThing>Steel</uiIconThing>
  </RecipeDef>

</Defs>
